  "section_1_overview_scope": {
    "title": "1. Project overview and UAT scope",
    "overview_paragraph": "FrinStore lets customers browse an ice cream catalog, manage a cart, and check out as authenticated users, while staff manage products and order statuses through an admin dashboard. UAT confirms these workflows meet day-to-day shop operations without developer intervention.",
    "in_scope_modules": [
      "Customer registration, login, logout, session handling",
      "Catalog browsing, product detail, and client-side discovery features as implemented",
      "Cart operations and checkout",
      "Order confirmation and customer-visible order history/status",
      "Admin catalog maintenance and order status updates",
      "Role-based access for guest, customer, and admin"
    ],
    "out_of_scope": "Live payment capture, third-party delivery, formal performance/load testing, and source-level debugging during UAT."
  },
  "section_2_objectives": {
    "title": "2. UAT objectives",
    "primary": "Confirm that a real customer tester can complete purchase-related tasks and that a staff tester can maintain catalog and orders without assistance.",
    "secondary": [
      "Validate clarity of errors and empty states",
      "Confirm mobile-friendly layout on common phone widths",
      "Collect qualitative feedback for future iterations"
    ]
  },
  "section_3_methodology_phases": {
